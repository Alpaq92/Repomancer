[Desktop Entry]
Type=Application
Name=Repomancer
GenericName=Version Control Client
Comment=A visual client for Git (and later SVN and Mercurial)
Exec=@REPOMANCER_BIN@ %f
Icon=repomancer
Terminal=false
Categories=Development;RevisionControl;
Keywords=git;vcs;version control;commit;branch;merge;
StartupNotify=true
MimeType=inode/directory;
