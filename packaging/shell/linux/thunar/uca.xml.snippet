<!-- Append these <action> blocks to ~/.config/Thunar/uca.xml (inside the
     root <actions> element), or add them via Thunar ▸ Configure custom
     actions. Replace @REPOMANCER_BIN@ with the installed binary path;
     install.sh does this for you. Each is set to appear on directories only. -->
<action>
	<icon>repomancer-log-symbolic</icon>
	<name>Repomancer: Log</name>
	<command>@REPOMANCER_BIN@ --action=log %f</command>
	<description>Open the commit history in Repomancer</description>
	<directories/>
</action>
<action>
	<icon>repomancer-commit-symbolic</icon>
	<name>Repomancer: Commit</name>
	<command>@REPOMANCER_BIN@ --action=commit %f</command>
	<description>Open the working tree to stage and commit</description>
	<directories/>
</action>
<action>
	<icon>repomancer-sync-symbolic</icon>
	<name>Repomancer: Sync (Fetch)</name>
	<command>@REPOMANCER_BIN@ --action=sync %f</command>
	<description>Fetch from the remotes</description>
	<directories/>
</action>
