{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "ninja-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja"
    },
    {
      "name": "linux-core-debug",
      "displayName": "Linux core+tests Debug (no GUI)",
      "inherits": "ninja-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "REPOMANCER_BUILD_GUI": "OFF"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug (GUI via vcpkg wx)",
      "inherits": "ninja-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_MANIFEST_FEATURES": "gui"
      }
    },
    {
      "name": "linux-debug-syswx",
      "displayName": "Linux Debug (GUI via system wxWidgets)",
      "inherits": "ninja-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release (GUI)",
      "inherits": "ninja-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_MANIFEST_FEATURES": "gui",
        "REPOMANCER_WERROR": "ON"
      }
    },
    {
      "name": "linux-release-syswx",
      "displayName": "Linux Release (GUI via system wxWidgets)",
      "inherits": "ninja-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "REPOMANCER_WERROR": "ON"
      }
    },
    {
      "name": "linux-asan",
      "displayName": "Linux ASan+UBSan core+tests",
      "inherits": "ninja-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "REPOMANCER_BUILD_GUI": "OFF",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "macos-debug",
      "displayName": "macOS Debug (GUI)",
      "inherits": "ninja-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_MANIFEST_FEATURES": "gui"
      }
    },
    {
      "name": "macos-release",
      "displayName": "macOS Release (GUI)",
      "inherits": "ninja-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_MANIFEST_FEATURES": "gui",
        "REPOMANCER_WERROR": "ON"
      }
    },
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows MSVC Debug (GUI)",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "VCPKG_MANIFEST_FEATURES": "gui"
      }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows MSVC Release (GUI)",
      "inherits": "windows-msvc-debug",
      "cacheVariables": {
        "VCPKG_MANIFEST_FEATURES": "gui",
        "REPOMANCER_WERROR": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-core-debug",
      "configurePreset": "linux-core-debug"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-debug-syswx",
      "configurePreset": "linux-debug-syswx"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-asan",
      "configurePreset": "linux-asan"
    },
    {
      "name": "macos-debug",
      "configurePreset": "macos-debug"
    },
    {
      "name": "macos-release",
      "configurePreset": "macos-release"
    },
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release",
      "configuration": "Release"
    },
    {
      "name": "linux-release-syswx",
      "configurePreset": "linux-release-syswx"
    }
  ],
  "testPresets": [
    {
      "name": "linux-core-debug",
      "configurePreset": "linux-core-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-debug-syswx",
      "configurePreset": "linux-debug-syswx",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-asan",
      "configurePreset": "linux-asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-release",
      "configurePreset": "macos-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-release-syswx",
      "configurePreset": "linux-release-syswx",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
